# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=amstack.org,www.amstack.org

# Database Settings
DATABASE_ENGINE=django.db.backends.mysql
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Email Settings (for SSL/TLS port 465)
EMAIL_HOST=amstack.org
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=noreply@amstack.org
EMAIL_HOST_PASSWORD=your_email_password_here
DEFAULT_FROM_EMAIL=AMStack <noreply@amstack.org>

# Site Settings
SITE_URL=https://amstack.org

# Coinbase Commerce (if using)
COINBASE_COMMERCE_API_KEY=your_coinbase_api_key
COINBASE_COMMERCE_WEBHOOK_SECRET=your_webhook_secret
